{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main-window capabilities. File paths are scoped globally here; plugin access is constrained by host-issued references in the bridge.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-decorations",
    "core:window:allow-start-dragging",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://release-assets.githubusercontent.com/*" },
        { "url": "https://objects.githubusercontent.com/*" },
        { "url": "https://huggingface.co/*" },
        { "url": "https://huggingface.com/*" }
      ]
    },

    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "/" },
        { "path": "/**/*" }
      ]
    },

    "log:default",
    "log:allow-log",
    "dialog:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "core:menu:default",
    "core:menu:allow-set-as-window-menu"
  ]
}
